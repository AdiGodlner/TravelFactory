{
	"compilerOptions": {
		"target": "ES2020",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",

		"rootDir": "./src",
		"outDir": "./dist",

		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,

		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,

		"esModuleInterop": true,
		"skipLibCheck": true
	},
	"include": ["src"]
}
